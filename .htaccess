# Für Hostinger (Apache/LiteSpeed) unter https://www.koenig-gebaeudereinigung.com/
# Saubere Adressen: /kontakt liefert kontakt.html aus.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer HTTPS und immer mit www (eine einzige Adresse für Suchmaschinen).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(koenig-gebaeudereinigung\.com)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

  # /index.html auf / umleiten, damit es keine doppelten Adressen gibt.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # Alte WordPress-Adressen der bisherigen Seite.
  RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|feed)(/|$) - [G,L]

  # .html in der Adresse auf die saubere Adresse umleiten (/kontakt.html -> /kontakt).
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # Alte Adressen mit Schrägstrich am Ende (/kontakt/) auf die neue Form umleiten.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Saubere Adresse auf die HTML-Datei abbilden.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Interne Arbeitsdateien nicht ausliefern.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(src|scripts|tests|docs|assets-source|node_modules)(/|$)
  RedirectMatch 404 ^/(package\.json|package-lock\.json|README\.md)$
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

# Komprimierung für Text-Dateien.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Zwischenspeichern: CSS und JS tragen eine Versionsnummer in der Adresse und dürfen ein Jahr bleiben.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
